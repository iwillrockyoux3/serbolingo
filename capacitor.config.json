{
  "appId": "com.serbolingo.app",
  "appName": "SerboLingo",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#2563eb",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
